# Template for local CoinGecko credentials. Copy to .env and fill in your key:
#
#   cp .env.example .env
#
# .env is gitignored; this template is not, and must never contain a real key.
# Load it into your shell before running anything:
#
#   set -a; source .env; set +a
#
# Or export the variable directly in your shell profile instead.

# Free Demo account key (https://www.coingecko.com/en/developers/dashboard)
COINGECKO_DEMO_API_KEY=

# Paid Pro plan key. Leave blank unless you have one: setting it switches the
# client to the Pro endpoint, which rejects Demo keys.
COINGECKO_API_KEY=
